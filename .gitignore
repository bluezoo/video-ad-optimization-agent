# Claude Code — local state stays out of git; vendored skills/agents + shared hook config are repo tooling
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# Local planning docs / notes (not for team distribution by default)
.docs/*
!.docs/version2-plan/
!.docs/.context/
.docs/.context/*
!.docs/.context/project_context.md

# Python
__pycache__/
*.py[cod]
.venv/
.venv-deploy/
*.egg-info/

# Env files
.env
app/.env

# Local databases
campaigns.db
app/campaigns.db

# ADK artifacts
app/.adk/

# Test / coverage
.pytest_cache/
htmlcov/
.coverage

# OS
.DS_Store
.superpowers/
